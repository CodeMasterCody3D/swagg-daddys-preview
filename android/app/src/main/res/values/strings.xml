<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Swagg Daddys Owner</string>
    <color name="brand_background">#080d0c</color>
    <color name="brand_accent">#47edbd</color>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
